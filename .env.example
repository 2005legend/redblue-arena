# Copy this file to .env and fill it in. .env is git-ignored; never commit real keys.
# Any OpenAI-compatible provider works. Examples of base URLs:
#   FreeLLM       http://100.93.147.107:3001/v1     model: auto:smart (Tailscale host, see models.yaml)
#   DeepSeek      https://api.deepseek.com          model: deepseek-chat
#   GitHub Models https://models.github.ai/inference model: (see the provider's model list)
ARENA_BASE_URL=
ARENA_API_KEY=
ARENA_MODEL=

# Optional: use different models for Red and Blue (they fall back to ARENA_MODEL)
ARENA_RED_MODEL=
ARENA_BLUE_MODEL=

# Optional: ordered per-role model pools; takes effect when ARENA_<ROLE>_MODEL is empty
# Shape: roles: {red: [id, ...], blue: [id, ...]}; may also set base_url and api_key_env
# (models.yaml in the repo ships the FreeLLM pools)
ARENA_MODELS_FILE=

# Optional: seconds a model rests after a provider failure (0 = retry immediately)
ARENA_MODEL_COOLDOWN=

# Optional: stop an agent once it has spent this many tokens (per agent; 0 = unlimited)
ARENA_TOKEN_BUDGET=0

# Optional: keep the patched target running after the verdict so /target stays browsable
# ARENA_KEEP_TARGET=1

# Note: ARENA_CONFIG (which config the server Start button loads) is read at import time.
# Set it in the shell before starting the server, not in this file:
#   set ARENA_CONFIG=arena.llm.yaml
